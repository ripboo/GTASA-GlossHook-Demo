<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">
    
    <!-- Permissions -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Features -->
    <uses-feature android:glEsVersion="0x30000"/>
    <uses-feature android:name="android.hardware.touchscreen.multitouch" android:required="false"/>

    <application 
        android:allowAudioPlaybackCapture="true" 
        android:icon="@android:drawable/sym_def_app_icon" 
        android:isGame="true" 
        android:label="GTA: SA + AML" 
        android:name="com.fastman92.main_activity_launcher.Application">
        
        <!-- Main Game Activity -->
        <activity 
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|uiMode|screenSize" 
            android:exported="false" 
            android:label="GTA: SA + AML" 
            android:launchMode="singleTask" 
            android:name="com.rockstargames.gtasa.GTASA" 
            android:resizeableActivity="false" 
            android:screenOrientation="landscape" 
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" 
            android:windowSoftInputMode="adjustPan"/>
        
        <!-- Launcher Activity -->
        <activity 
            android:exported="true" 
            android:label="GTA: SA + AML" 
            android:launchMode="singleTask" 
            android:name="com.fastman92.main_activity_launcher.MainActivity" 
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
            <meta-data android:name="ACTIVITY_TO_LAUNCH" android:value="com.rockstargames.gtasa.GTASA"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Settings Loader -->
        <activity 
            android:exported="true" 
            android:name="com.fastman92.main_activity_launcher.SettingsLoader" 
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="com.rockstargames.gtasa.SETTINGS_LOADER"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- AML Configuration Meta-Data -->
        <meta-data android:name="APP_NAME" android:value="com.rockstargames.gtasa"/>
        <meta-data android:name="LAUNCHER_USE_LAUNCHER_SETTINGS_XML" android:value="no"/>
        <meta-data android:name="LAUNCHER_ORIGINAL_PACKAGE_NAME" android:value="com.rockstargames.gtasa"/>
        <meta-data android:name="LAUNCHER_USE_ANDROID_UNPROTECTED_DIRECTORY" android:value="yes"/>
        <meta-data android:name="LAUNCHER_ANDROID_DATA_DIRECTORY" android:value="com.rockstargames.gtasa"/>
        <meta-data android:name="LAUNCHER_ANDROID_OBB_DIRECTORY" android:value="com.rockstargames.gtasa"/>
        <meta-data android:name="LAUNCHER_CHECK_FOR_MULTIPLE_DIRS" android:value="no"/>
        <meta-data android:name="LAUNCHER_ASSETPACKS_USED" android:value="no"/>
        <meta-data android:name="LAUNCHER_SHOW_MESSAGE_BOX_ON_APPLICATION_STARTUP" android:value="no"/>

    </application>
</manifest>
